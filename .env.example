# ---------------------------------------------------------------------------
# Bunny CDN
#
# Leave NEXT_PUBLIC_CDN_URL unset for local development: the site then serves
# media straight out of public/ and needs none of this.
# ---------------------------------------------------------------------------

# Your Bunny pull zone, no trailing slash. This is the only variable the
# website itself reads, and it must be NEXT_PUBLIC — the 3D binder loads its
# page textures in the browser.
NEXT_PUBLIC_CDN_URL=https://your-zone.b-cdn.net

# --- Upload only. Never sent to the browser. -------------------------------

# Storage zone name, and its password from
# bunny.net → Storage → your zone → FTP & API Access → Password.
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_KEY=

# Storage region endpoint. Falkenstein is the default; others are
# ny. la. sg. syd. uk. se. br. jh. — e.g. ny.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# Optional: account API key, from bunny.net → Account → API.
# Only needed if you want the upload to purge the cache when it finishes.
BUNNY_API_KEY=
